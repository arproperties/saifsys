# Allow Authorization header to be passed to PHP
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Set Authorization header for PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Public Find Your Home long-term rental API.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^long-term-rentals(?:/.*)?$ long_term_rentals.php [L,QSA]

# Public property share resolve API.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^property-share(?:/.*)?$ property_share.php [L,QSA]

