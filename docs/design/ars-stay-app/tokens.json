{
  "$schema": "https://design-tokens.org/community-group/format/",
  "$meta": {
    "name": "ARS Home Rentals — Mobile",
    "version": "1.0.0",
    "source": "Book Luxury Stays concept mockup",
    "note": "Canonical source of truth. Generate platform themes from this file; do not hand-copy hex values. Gold 600/700 and the semantic + booking status colors intentionally match modules/ars/assets/ars_styles.css so staff web and guest mobile agree."
  },

  "color": {
    "navy": {
      "900": { "$value": "#0A1729", "$type": "color", "$description": "Deepest hero gradient stop, status bar scrim" },
      "800": { "$value": "#0E2038", "$type": "color", "$description": "Dark surface background, splash" },
      "700": { "$value": "#10233C", "$type": "color", "$description": "Primary navy — hero base, bottom nav" },
      "600": { "$value": "#16304F", "$type": "color", "$description": "Raised navy surface" },
      "500": { "$value": "#1D3A5C", "$type": "color", "$description": "Navy card / pressed state" },
      "400": { "$value": "#2B4E75", "$type": "color", "$description": "Border and divider on navy" },
      "300": { "$value": "#5B7799", "$type": "color", "$description": "Muted icon / secondary text on navy" }
    },
    "gold": {
      "50":  { "$value": "#FBF3E4", "$type": "color", "$description": "Tint wash behind gold icons" },
      "100": { "$value": "#F7E3BE", "$type": "color", "$description": "Stepper buttons, icon circles" },
      "200": { "$value": "#EDD5A3", "$type": "color", "$description": "Disabled gold fill" },
      "300": { "$value": "#DCBC7E", "$type": "color", "$description": "Pressed gold; gold text in dark theme" },
      "400": { "$value": "#D0AA66", "$type": "color", "$description": "Hover gold" },
      "500": { "$value": "#C6A15E", "$type": "color", "$description": "Brand gold — primary button, rules, headline accent" },
      "600": { "$value": "#B8860B", "$type": "color", "$description": "Legacy web-app gold; icons on cream" },
      "700": { "$value": "#8A6808", "$type": "color", "$description": "Gold TEXT on light backgrounds (AA safe, 5.9:1)" }
    },
    "cream": {
      "0":   { "$value": "#FFFFFF", "$type": "color", "$description": "Chip cards, elevated tiles, modals" },
      "50":  { "$value": "#FCF9F4", "$type": "color", "$description": "Sheet background — main scrolling surface" },
      "100": { "$value": "#F7F5F0", "$type": "color", "$description": "Alt page background (matches web --ars-bg)" },
      "200": { "$value": "#F6EEE1", "$type": "color", "$description": "Inset panel" },
      "300": { "$value": "#F1E5D2", "$type": "color", "$description": "Input field fill" },
      "400": { "$value": "#E8E4DC", "$type": "color", "$description": "Border (matches web --ars-border)" },
      "500": { "$value": "#DCD4C6", "$type": "color", "$description": "Strong divider" }
    },
    "text": {
      "primary":     { "$value": "#1A1A1A", "$type": "color" },
      "secondary":   { "$value": "#4A4A4A", "$type": "color" },
      "muted":       { "$value": "#6B7280", "$type": "color" },
      "disabled":    { "$value": "#9CA3AF", "$type": "color" },
      "onNavy":      { "$value": "#FFFFFF", "$type": "color" },
      "onNavyMuted": { "$value": "#C8D3E0", "$type": "color" },
      "onGold":      { "$value": "#1A1A1A", "$type": "color", "$description": "Never white on gold" }
    },
    "semantic": {
      "success": { "$value": "#059669", "$type": "color" },
      "warning": { "$value": "#D97706", "$type": "color" },
      "danger":  { "$value": "#DC2626", "$type": "color" },
      "info":    { "$value": "#0284C7", "$type": "color" }
    },
    "bookingStatus": {
      "pending":    { "$value": "#D97706", "$type": "color" },
      "confirmed":  { "$value": "#B8860B", "$type": "color" },
      "checkedIn":  { "$value": "#059669", "$type": "color" },
      "checkedOut": { "$value": "#64748B", "$type": "color" },
      "cancelled":  { "$value": "#DC2626", "$type": "color" },
      "noShow":     { "$value": "#9A3412", "$type": "color" }
    }
  },

  "gradient": {
    "hero":      { "$value": "linear-gradient(145deg, #0A1729 0%, #10233C 45%, #1D3A5C 100%)", "$type": "gradient" },
    "heroScrim": { "$value": "linear-gradient(180deg, rgba(10,23,41,0) 35%, rgba(10,23,41,0.78) 100%)", "$type": "gradient" }
  },

  "font": {
    "family": {
      "serif": { "$value": "Playfair Display", "$type": "fontFamily", "$description": "Display voice. Fallback: Georgia, 'Times New Roman', serif" },
      "sans":  { "$value": "Plus Jakarta Sans", "$type": "fontFamily", "$description": "All UI. Bundled at modules/ars/assets/vendor/fonts/plus-jakarta-sans/" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    }
  },

  "typography": {
    "displayXl": { "$type": "typography", "$value": { "fontFamily": "serif", "fontSize": 56, "lineHeight": 60, "fontWeight": 700, "letterSpacing": "-0.02em" } },
    "displayLg": { "$type": "typography", "$value": { "fontFamily": "serif", "fontSize": 40, "lineHeight": 46, "fontWeight": 700, "letterSpacing": "-0.015em" } },
    "h1":        { "$type": "typography", "$value": { "fontFamily": "serif", "fontSize": 32, "lineHeight": 38, "fontWeight": 700, "letterSpacing": "-0.01em" } },
    "h2":        { "$type": "typography", "$value": { "fontFamily": "serif", "fontSize": 24, "lineHeight": 30, "fontWeight": 600, "letterSpacing": "-0.01em" } },
    "h3":        { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 19, "lineHeight": 26, "fontWeight": 700, "letterSpacing": "0" } },
    "subtitle":  { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 17, "lineHeight": 24, "fontWeight": 600, "letterSpacing": "0" } },
    "bodyLg":    { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 17, "lineHeight": 26, "fontWeight": 500, "letterSpacing": "0" } },
    "body":      { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 15, "lineHeight": 23, "fontWeight": 400, "letterSpacing": "0" } },
    "label":     { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 13, "lineHeight": 18, "fontWeight": 600, "letterSpacing": "0.01em" } },
    "caption":   { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 13, "lineHeight": 18, "fontWeight": 400, "letterSpacing": "0" } },
    "chip":      { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 12, "lineHeight": 16, "fontWeight": 600, "letterSpacing": "0" } },
    "button":    { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 17, "lineHeight": 22, "fontWeight": 700, "letterSpacing": "0.01em" } },
    "overline":  { "$type": "typography", "$value": { "fontFamily": "sans", "fontSize": 11, "lineHeight": 14, "fontWeight": 600, "letterSpacing": "0.18em", "textTransform": "uppercase" } },
    "wordmark":  { "$type": "typography", "$value": { "fontFamily": "serif", "fontSize": 12, "lineHeight": 16, "fontWeight": 400, "letterSpacing": "0.38em", "textTransform": "uppercase" } }
  },

  "space": {
    "1":  { "$value": 4,  "$type": "dimension" },
    "2":  { "$value": 8,  "$type": "dimension" },
    "3":  { "$value": 12, "$type": "dimension" },
    "4":  { "$value": 16, "$type": "dimension" },
    "5":  { "$value": 20, "$type": "dimension" },
    "6":  { "$value": 24, "$type": "dimension" },
    "8":  { "$value": 32, "$type": "dimension" },
    "10": { "$value": 40, "$type": "dimension" },
    "12": { "$value": 48, "$type": "dimension" }
  },

  "layout": {
    "screenPadding":   { "$value": 20, "$type": "dimension" },
    "sheetPadding":    { "$value": 20, "$type": "dimension" },
    "cardPadding":     { "$value": 16, "$type": "dimension" },
    "cardGap":         { "$value": 12, "$type": "dimension" },
    "chipGap":         { "$value": 10, "$type": "dimension" },
    "sectionGap":      { "$value": 28, "$type": "dimension" },
    "bottomNavHeight": { "$value": 64, "$type": "dimension" },
    "minTapTarget":    { "$value": 44, "$type": "dimension" },
    "heroHeightRatio": { "$value": 0.42, "$type": "number" }
  },

  "radius": {
    "sm":     { "$value": 10,  "$type": "dimension" },
    "md":     { "$value": 14,  "$type": "dimension" },
    "lg":     { "$value": 20,  "$type": "dimension" },
    "xl":     { "$value": 28,  "$type": "dimension" },
    "button": { "$value": 16,  "$type": "dimension" },
    "full":   { "$value": 999, "$type": "dimension" }
  },

  "elevation": {
    "sm":    { "$value": "0 1px 3px rgba(26,26,26,0.05), 0 1px 2px rgba(184,134,11,0.05)", "$type": "shadow", "$description": "Android elevation 1" },
    "md":    { "$value": "0 4px 16px rgba(26,26,26,0.07)", "$type": "shadow", "$description": "Android elevation 3" },
    "lg":    { "$value": "0 12px 32px rgba(26,26,26,0.12)", "$type": "shadow", "$description": "Android elevation 8" },
    "sheet": { "$value": "0 -8px 24px rgba(10,23,41,0.10)", "$type": "shadow" },
    "gold":  { "$value": "0 8px 20px rgba(198,161,94,0.35)", "$type": "shadow" }
  },

  "motion": {
    "fast":        { "$value": "150ms", "$type": "duration" },
    "base":        { "$value": "200ms", "$type": "duration" },
    "slow":        { "$value": "250ms", "$type": "duration" },
    "sheet":       { "$value": "320ms", "$type": "duration" },
    "easing":      { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",   "$type": "cubicBezier" },
    "easingSheet": { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier" },
    "pressScale":  { "$value": 0.98, "$type": "number" }
  },

  "theme": {
    "light": {
      "background":    { "$value": "{color.cream.50}" },
      "surface":       { "$value": "{color.cream.0}" },
      "surfaceInset":  { "$value": "{color.cream.200}" },
      "field":         { "$value": "{color.cream.300}" },
      "border":        { "$value": "{color.cream.400}" },
      "textPrimary":   { "$value": "{color.text.primary}" },
      "textSecondary": { "$value": "{color.text.secondary}" },
      "textMuted":     { "$value": "{color.text.muted}" },
      "accentText":    { "$value": "{color.gold.700}" },
      "accentFill":    { "$value": "{color.gold.500}" },
      "onAccentFill":  { "$value": "{color.text.onGold}" }
    },
    "dark": {
      "background":    { "$value": "{color.navy.800}" },
      "surface":       { "$value": "{color.navy.600}" },
      "surfaceInset":  { "$value": "#132B48" },
      "field":         { "$value": "{color.navy.500}" },
      "border":        { "$value": "{color.navy.400}" },
      "textPrimary":   { "$value": "#F5F1EA" },
      "textSecondary": { "$value": "{color.text.onNavyMuted}" },
      "textMuted":     { "$value": "#8FA3B8" },
      "accentText":    { "$value": "{color.gold.300}" },
      "accentFill":    { "$value": "{color.gold.500}" },
      "onAccentFill":  { "$value": "{color.text.onGold}" }
    }
  },

  "a11y": {
    "rules": [
      "gold.500 on cream/white is 2.4:1 — never use it for text under 24pt; use gold.700 instead",
      "gold.500 fill with #1A1A1A text is 6.1:1 — this is the primary button; never white on gold",
      "gold.500 text on navy.700 is 6.4:1 — safe",
      "gold.700 text on cream.50 is 5.9:1 — safe",
      "in dark theme use gold.300 for accent text; gold.700 fails on navy",
      "all tap targets minimum 44x44",
      "status is never communicated by color alone — always pair with the status word"
    ]
  }
}
